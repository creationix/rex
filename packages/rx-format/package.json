{
	"name": "@creationix/rx",
	"version": "0.6.8",
	"description": "REXC encoder, decoder, and CLI data tool",
	"keywords": [
		"rexc",
		"rx",
		"encoder",
		"decoder",
		"streaming",
		"data"
	],
	"type": "module",
	"bin": {
		"rx": "rx-cli.ts"
	},
	"main": "rx.ts",
	"exports": {
		".": {
			"types": "./rx.ts",
			"default": "./rx.ts"
		},
		"./b64": {
			"types": "./b64.ts",
			"default": "./b64.ts"
		}
	},
	"files": [
		"README.md",
		"LICENSE",
		"b64.ts",
		"rx.ts",
		"rx-cli.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"prepublishOnly": "bun test",
		"test": "bun test"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/creationix/rex.git",
		"directory": "packages/rx-format"
	},
	"homepage": "https://github.com/creationix/rex/tree/main/packages/rx-format#readme",
	"license": "MIT",
	"devDependencies": {
		"@types/bun": "latest",
		"vitest": "^4.1.0"
	}
}