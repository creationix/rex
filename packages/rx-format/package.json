{
	"name": "@creationix/rx",
	"version": "0.2.0",
	"description": "REXC encoder, decoder, and CLI data tool",
	"keywords": [
		"rexc",
		"rx",
		"encoder",
		"decoder",
		"streaming",
		"data"
	],
	"type": "module",
	"bin": {
		"rx": "dist/rx-cli.js"
	},
	"main": "rx.ts",
	"types": "./rx.ts",
	"exports": {
		".": "./rx.ts"
	},
	"files": [
		"README.md",
		"LICENSE",
		"rx.ts",
		"rx-cli.ts",
		"dist/rx-cli.js"
	],
	"scripts": {
		"build": "bun build rx-cli.ts --outfile dist/rx-cli.js --target node --banner \"#!/usr/bin/env node\"",
		"prepublishOnly": "bun run build",
		"test": "bun test"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/creationix/rex.git",
		"directory": "packages/rx-format"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/bun": "latest"
	}
}