{
	"name": "@creationix/rx",
	"version": "0.6.1",
	"description": "REXC encoder, decoder, and CLI data tool",
	"keywords": [
		"rexc",
		"rx",
		"encoder",
		"decoder",
		"streaming",
		"data"
	],
	"type": "module",
	"bin": {
		"rx": "dist/rx-cli.js"
	},
	"main": "dist/rx.js",
	"types": "dist/rx.d.ts",
	"exports": {
		".": {
			"types": "./dist/rx.d.ts",
			"bun": "./rx.ts",
			"default": "./dist/rx.js"
		}
	},
	"files": [
		"README.md",
		"LICENSE",
		"b64.ts",
		"rx.ts",
		"rx-cli.ts",
		"dist"
	],
	"scripts": {
		"build": "bun build rx.ts --outfile dist/rx.js --target node && bun build rx-cli.ts --outfile dist/rx-cli.js --target node --banner \"#!/usr/bin/env node\" && tsc",
		"prepublishOnly": "bun test && bun run build",
		"test": "bun test"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/creationix/rex.git",
		"directory": "packages/rx-format"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/bun": "latest"
	}
}