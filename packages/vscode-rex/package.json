{
	"name": "rex-vscode",
	"displayName": "Rex",
	"description": "Rex language support for Visual Studio Code",
	"version": "0.9.0",
	"publisher": "creationix",
	"icon": "img/rex-icon-dark.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/creationix/rex",
		"directory": "packages/vscode-rex"
	},
	"main": "./dist/extension.js",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "rex",
				"aliases": [
					"Rex Language",
					"rex"
				],
				"extensions": [
					".rex",
					".rexd"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./img/rex-icon-light.svg",
					"dark": "./img/rex-icon-dark.svg"
				}
			},
			{
				"id": "rx",
				"aliases": [
					"RX Binary"
				],
				"extensions": [
					".rx",
					".rexc"
				],
				"icon": {
					"light": "./img/rx-icon-light.svg",
					"dark": "./img/rx-icon-dark.svg"
				}
			}
		],
		"configuration": {
			"title": "Rex",
			"properties": {
				"rex.domainFile": {
					"type": "string",
					"description": "Path to the .rexd domain interface file. Auto-discovered from workspace if not set.",
					"default": ""
				},
				"rex.path": {
					"type": "string",
					"description": "Path to the rex binary. Uses PATH if not set.",
					"default": ""
				}
			}
		},
		"configurationDefaults": {
			"[rex]": {
				"editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?"
			}
		},
		"grammars": [
			{
				"language": "rex",
				"scopeName": "source.rex",
				"path": "./syntaxes/rex.tmLanguage.json"
			},
			{
				"scopeName": "markdown.rex.codeblock",
				"path": "./syntaxes/rex-markdown.tmLanguage.json",
				"injectTo": [
					"text.html.markdown",
					"source.gfm"
				],
				"embeddedLanguages": {
					"meta.embedded.block.rex": "rex"
				}
			},
			{
				"scopeName": "inline.rex.tagged-template",
				"path": "./syntaxes/rex-typescript.tmLanguage.json",
				"injectTo": [
					"source.ts",
					"source.tsx",
					"source.js",
					"source.jsx",
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.rex": "rex"
				}
			}
		]
	},
	"scripts": {
		"build:webview": "cd ../web-viewer && bun vite build --config vite.webview.config.ts",
		"build:extension": "npx esbuild src/extension.ts --bundle --outfile=dist/extension.js --format=cjs --platform=node --external:vscode --target=node18",
		"build:browser": "bun build src/browser.ts --outfile dist/browser.js --external vscode --format esm --target browser",
		"build:server-browser": "bun build src/server-browser.ts --outfile dist/server-browser.js --format esm --target browser",
		"build:wasm": "cd ../rusty-rex && wasm-pack build crates/rex-wasm --target no-modules --out-dir ../../../vscode-rex/wasm",
		"build": "bun run build:webview && bun run build:extension && bun run build:browser && bun run build:server-browser",
		"test": "bun test",
		"package": "bun run build && bunx @vscode/vsce package --no-dependencies",
		"reinstall": "bun run package && code --install-extension ./rex-vscode-0.9.0.vsix --force",
		"publish": "bun run build && bunx @vscode/vsce publish --no-dependencies"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.0",
		"vscode-languageserver": "^9.0.0",
		"vscode-languageserver-textdocument": "^1.0.0"
	},
	"devDependencies": {
		"@types/vscode": "^1.75.0"
	},
	"private": true
}
