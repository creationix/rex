{
	"name": "rex-vscode",
	"displayName": "Rex",
	"description": "Rex language support for Visual Studio Code",
	"version": "0.7.1",
	"publisher": "creationix",
	"icon": "img/rex-icon-dark.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/creationix/rex",
		"directory": "packages/vscode-rex"
	},
	"main": "./dist/extension.js",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "rex",
				"aliases": [
					"Rex Language",
					"rex"
				],
				"extensions": [
					".rex"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./img/rex-icon-light.svg",
					"dark": "./img/rex-icon-dark.svg"
				}
			},
			{
				"id": "rx",
				"aliases": [
					"RX Binary"
				],
				"extensions": [
					".rx",
					".rexc"
				],
				"icon": {
					"light": "./img/rx-icon-light.svg",
					"dark": "./img/rx-icon-dark.svg"
				}
			}
		],
		"configurationDefaults": {
			"[rex]": {
				"editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?"
			}
		},
		"customEditors": [
			{
				"viewType": "rex.rxViewer",
				"displayName": "RX Viewer",
				"selector": [
					{
						"filenamePattern": "*.rx"
					},
					{
						"filenamePattern": "*.rexc"
					}
				],
				"priority": "default"
			}
		],
		"semanticTokenTypes": [
			{
				"id": "rexLocal",
				"superType": "variable",
				"description": "User-defined local symbol in Rex"
			},
			{
				"id": "rexDomain",
				"superType": "type",
				"description": "Domain/platform-provided symbol in Rex"
			}
		],
		"semanticTokenScopes": [
			{
				"scopes": {
					"rexLocal": ["variable.other.rex"],
					"rexDomain": ["support.class.rex"]
				}
			}
		],
		"grammars": [
			{
				"language": "rex",
				"scopeName": "source.rex",
				"path": "./syntaxes/rex.tmLanguage.json"
			},
			{
				"scopeName": "markdown.rex.codeblock",
				"path": "./syntaxes/rex-markdown.tmLanguage.json",
				"injectTo": [
					"text.html.markdown",
					"source.gfm"
				],
				"embeddedLanguages": {
					"meta.embedded.block.rex": "rex"
				}
			},
			{
				"scopeName": "inline.rex.tagged-template",
				"path": "./syntaxes/rex-typescript.tmLanguage.json",
				"injectTo": [
					"source.ts",
					"source.tsx",
					"source.js",
					"source.jsx",
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.rex": "rex"
				}
			}
		]
	},
	"scripts": {
		"build:webview": "cd ../web-viewer && bun vite build --config vite.webview.config.ts",
		"build:extension": "bun build src/extension.ts --outfile dist/extension.js --external vscode --format cjs --target node",
		"build": "bun run build:webview && bun run build:extension",
		"test": "bun test",
		"package": "bun run build && bunx @vscode/vsce package --no-dependencies",
		"reinstall": "bun run package && code --install-extension ./rex-vscode-0.7.1.vsix --force",
		"publish": "bun run build && bunx @vscode/vsce publish --no-dependencies"
	},
	"devDependencies": {
		"@types/vscode": "^1.75.0"
	},
	"private": true
}
