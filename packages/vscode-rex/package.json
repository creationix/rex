{
	"name": "rex-vscode",
	"displayName": "Rex",
	"description": "Rex language support for Visual Studio Code",
	"version": "0.9.0",
	"publisher": "creationix",
	"icon": "img/rex-icon-dark.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/creationix/rex",
		"directory": "packages/vscode-rex"
	},
	"main": "./dist/extension.js",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:rext",
		"onLanguage:markdown"
	],
	"contributes": {
		"languages": [
			{
				"id": "rex",
				"aliases": [
					"Rex Language",
					"rex"
				],
				"extensions": [
					".rex",
					".rexd"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./img/rex-icon-light.svg",
					"dark": "./img/rex-icon-dark.svg"
				}
			},
			{
				"id": "rext",
				"aliases": [
					"Rex Bytecode"
				],
				"extensions": [
					".rext"
				],
				"configuration": "./rext-language-configuration.json"
			},
			{
				"id": "rx",
				"aliases": [
					"RX Binary"
				],
				"extensions": [
					".rx"
				],
				"configuration": "./rext-language-configuration.json",
				"icon": {
					"light": "./img/rx-icon-light.svg",
					"dark": "./img/rx-icon-dark.svg"
				}
			}
		],
		"configuration": {
			"title": "Rex",
			"properties": {
				"rex.domainFile": {
					"type": "string",
					"description": "Path to the .rexd domain interface file. Auto-discovered from workspace if not set.",
					"default": ""
				},
				"rex.path": {
					"type": "string",
					"description": "Path to the rex binary. Uses PATH if not set.",
					"default": ""
				}
			}
		},
		"configurationDefaults": {
			"[rex]": {
				"editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
				"editor.semanticHighlighting.enabled": true
			},
			"[rext]": {
				"editor.semanticHighlighting.enabled": true,
				"editor.wordWrap": "on"
			},
			"[rx]": {
				"editor.semanticHighlighting.enabled": true,
				"editor.wordWrap": "on"
			}
		},
		"semanticTokenScopes": [
			{
				"language": "rex",
				"scopes": {
					"variable": ["variable.other.rex"],
					"property": ["variable.other.property.rex"],
					"function": ["entity.name.function.rex"],
					"function.defaultLibrary": ["support.function.rex"],
					"type": ["entity.name.type.rex"],
					"parameter": ["variable.parameter.rex"]
				}
			},
			{
				"language": "rext",
				"scopes": {
					"property": ["support.type.property-name.rext"]
				}
			},
			{
				"language": "rx",
				"scopes": {
					"property": ["support.type.property-name.rx"]
				}
			},
			{
				"language": "markdown",
				"scopes": {
					"property": ["support.type.property-name"]
				}
			}
		],
		"grammars": [
			{
				"language": "rex",
				"scopeName": "source.rex",
				"path": "./syntaxes/rex.tmLanguage.json"
			},
			{
				"language": "rext",
				"scopeName": "source.rext",
				"path": "./syntaxes/rext.tmLanguage.json"
			},
			{
				"language": "rx",
				"scopeName": "source.rx",
				"path": "./syntaxes/rx.tmLanguage.json"
			},
			{
				"scopeName": "markdown.rex.codeblock",
				"path": "./syntaxes/rex-markdown.tmLanguage.json",
				"injectTo": [
					"text.html.markdown",
					"source.gfm"
				],
				"embeddedLanguages": {
					"meta.embedded.block.rex": "rex",
					"meta.embedded.block.rext": "rext"
				}
			},
			{
				"scopeName": "inline.rex.tagged-template",
				"path": "./syntaxes/rex-typescript.tmLanguage.json",
				"injectTo": [
					"source.ts",
					"source.tsx",
					"source.js",
					"source.jsx",
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.rex": "rex"
				}
			}
		]
	},
	"scripts": {
		"build:extension": "npx esbuild src/extension.ts --bundle --outfile=dist/extension.js --format=cjs --platform=node --external:vscode --target=node18",
		"build": "bun run build:extension",
		"test": "bun test",
		"package": "bun run build && bunx @vscode/vsce package --no-dependencies",
		"reinstall": "bun run package && code --install-extension ./rex-vscode-0.9.0.vsix --force",
		"publish": "bun run build && bunx @vscode/vsce publish --no-dependencies"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.0"
	},
	"devDependencies": {
		"@types/vscode": "^1.75.0"
	},
	"private": true
}
