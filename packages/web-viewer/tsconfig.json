{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["svelte", "vite/client"],
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": false,
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
